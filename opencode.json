{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "test": {
      "models": {
        "muse-spark-1.3-contributor-free": {
          "name": "muse-spark-1.3-contributor-free",
          "limit": {
            "context": 1000000,
            "output": 90000
          },
          "variants": {
            "minimal": {
              "reasoningEffort": "minimal",
              "reasoningSummary": "auto",
              "include": ["reasoning.encrypted_content"]
